# Python gitignore
# See https://github.com/github/gitignore/blob/main/Python.gitignore

# Byte‑compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtualenv
venv/
ENV/
.env/
.

# IDE / editor files
.idea/
.vscode/
*.swp
*.swo
*.swn

# OS generated files
.DS_Store
Thumbs.db
